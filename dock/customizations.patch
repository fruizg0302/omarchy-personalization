-    return items;
+    // Keep this machine's utility shortcuts after running applications.
+    var utilityIds = ["local-applications", "local-downloads", "local-trash"];
+    var mainItems = [];
+    var utilityItems = {};
+    for (var ui = 0; ui < items.length; ui++) {
+        var utilityId = stripDesktop(items[ui].appId);
+        if (utilityIds.indexOf(utilityId) !== -1) utilityItems[utilityId] = items[ui];
+        else mainItems.push(items[ui]);
+    }
+    for (var uj = 0; uj < utilityIds.length; uj++) {
+        if (utilityItems[utilityIds[uj]]) mainItems.push(utilityItems[utilityIds[uj]]);
+    }
+    return mainItems;
