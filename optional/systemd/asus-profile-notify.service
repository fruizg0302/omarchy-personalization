[Unit]
Description=ASUS power profile change notifications
After=graphical-session.target
PartOf=graphical-session.target
ConditionPathExists=/sys/firmware/acpi/platform_profile

[Service]
ExecStart=/usr/bin/python3 %h/.local/bin/asus-profile-notify.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
